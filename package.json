{
  "name": "acme-pay",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @acme/shared && npm run build -w @acme/api && npm run build -w @acme/web",
    "dev:api": "npm run dev -w @acme/api",
    "dev:web": "npm run dev -w @acme/web",
    "db:up": "docker compose up -d db",
    "db:seed": "npm run seed -w @acme/api",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @acme/shared && npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
