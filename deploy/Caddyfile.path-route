	# ACME Pay at /acme-pay (paste inside the existing site block, above other handle blocks)
	@acmePayApi path /acme-pay/api/*
	handle @acmePayApi {
		request_body {
			max_size 1MB
		}
		uri strip_prefix /acme-pay
		header {
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}
		reverse_proxy acme-pay-api:3001
	}

	@acmePayWeb path /acme-pay /acme-pay/*
	handle @acmePayWeb {
		header -Server
		reverse_proxy acme-pay-web:3000
	}
