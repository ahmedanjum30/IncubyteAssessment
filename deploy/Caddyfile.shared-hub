	# ACME Pay at /acme-pay, plus a chooser on the bare root of a shared host.
	# Paste inside the existing site block, directly after "encode".

	@acmePayApi path /acme-pay/api/*
	handle @acmePayApi {
		request_body {
			max_size 1MB
		}
		uri strip_prefix /acme-pay
		header {
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			-Server
		}
		reverse_proxy acme-api:3001
	}

	@acmePayWeb path /acme-pay /acme-pay/*
	handle @acmePayWeb {
		header -Server
		reverse_proxy acme-web:3000
	}

	@hub expression `{http.request.uri.path} == "/" && {http.request.uri.query} == ""`
	handle @hub {
		header {
			Content-Type "text/html; charset=utf-8"
			Cache-Control "public, max-age=300"
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
		}
		respond <<HTML
			<!doctype html>
			<html lang="en">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Apps on this server</title>
			<style>
			:root{--bg:#f5f4f6;--ink:#16181a;--ink2:#55585d;--hair:#c9c7c4;--accent:#4b4fa8;color-scheme:light}
			*{box-sizing:border-box;margin:0}
			body{min-height:100dvh;display:grid;place-items:center;padding:40px 16px;background:radial-gradient(900px 600px at 0 0,#faf6f5,transparent 60%),radial-gradient(900px 600px at 100% 100%,#eef3ef,transparent 60%),var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
			main{width:min(880px,100%)}
			h1{font-weight:400;font-size:clamp(32px,5vw,52px);letter-spacing:-.025em;line-height:1.05}
			p.lede{color:var(--ink2);margin:12px 0 32px;max-width:52ch}
			ul{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));border-top:1px solid var(--ink)}
			li{border-bottom:1px solid var(--hair)}
			li+li{border-left:1px solid var(--hair)}
			a{display:block;height:100%;padding:24px 24px 28px;color:inherit;text-decoration:none;transition:background .15s}
			a:hover{background:rgba(255,255,255,.7)}
			a:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
			h2{font-weight:500;font-size:22px;letter-spacing:-.01em;display:flex;justify-content:space-between;align-items:baseline}
			h2 span{font-size:18px;transition:transform .2s}
			a:hover h2 span{transform:translateX(4px)}
			a p{color:var(--ink2);margin-top:6px}
			@media (max-width:600px){li+li{border-left:0}}
			@media (prefers-reduced-motion:reduce){*{transition:none!important}}
			</style>
			</head>
			<body>
			<main>
			<h1>Apps on this server</h1>
			<p class="lede">Two projects share this machine. Pick where you want to go.</p>
			<ul>
			<li><a href="/?app=playflight"><h2>PlayFlight <span aria-hidden="true">&rarr;</span></h2><p>TestFlight for Android: share builds with testers.</p></a></li>
			<li><a href="/acme-pay"><h2>ACME Pay <span aria-hidden="true">&rarr;</span></h2><p>Salary management and pay insights for 10,000 employees.</p></a></li>
			</ul>
			</main>
			</body>
			</html>
			HTML 200
	}
